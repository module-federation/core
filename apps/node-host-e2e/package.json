{
  "name": "node-host-e2e",
  "private": true,
  "type": "module",
  "description": "Rstest suite that loads the built Node federation remotes.",
  "scripts": {
    "e2e": "pnpm exec rstest run -c rstest.config.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=false pnpm exec eslint --ignore-pattern node_modules --ext .js,.ts ."
  },
  "devDependencies": {
    "@module-federation/rstest": "workspace:*",
    "@module-federation/runtime": "workspace:*",
    "@rstest/core": "0.12.3",
    "node-dynamic-remote": "workspace:*",
    "node-dynamic-remote-new-version": "workspace:*",
    "node-local-remote": "workspace:*",
    "node-remote": "workspace:*",
    "sirv": "3.0.2"
  }
}
