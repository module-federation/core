{
  "name": "skills-over-mcp-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Federated Skills Over MCP proof of concept",
  "scripts": {
    "build": "NODE_OPTIONS=--max_old_space_size=4096 pnpm exec rspack build --config rspack.config.cjs --mode production",
    "demo": "node src/demo.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=false pnpm exec eslint --no-error-on-unmatched-pattern --ignore-pattern node_modules \"src/**/*.ts\"",
    "pretest": "pnpm run build",
    "providers": "node src/serve-providers.ts",
    "start": "node dist/gateway/main.cjs",
    "test": "node --test src/*.test.ts",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@module-federation/enhanced": "workspace:*",
    "@module-federation/node": "workspace:*",
    "@module-federation/runtime": "workspace:*",
    "zod": "4.6.5"
  }
}
