{
  "name": "@module-federation/sdk",
  "version": "2.9.0",
  "type": "module",
  "license": "MIT",
  "description": "A sdk for support module federation",
  "keywords": [
    "Module Federation",
    "sdk"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/module-federation/core.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "zhanghang <hanric.zhang@gmail.com>",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "url": false
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./normalize-webpack-path": {
      "import": {
        "types": "./dist/normalize-webpack-path.d.ts",
        "default": "./dist/normalize-webpack-path.js"
      },
      "require": {
        "types": "./dist/normalize-webpack-path.d.ts",
        "default": "./dist/normalize-webpack-path.cjs"
      }
    }
  },
  "imports": {
    "#mf/env": {
      "module-federation:target-web": {
        "types": "./dist/selectors/env/web.d.ts",
        "import": "./dist/selectors/env/web.js",
        "require": "./dist/selectors/env/web.cjs",
        "default": "./dist/selectors/env/web.js"
      },
      "module-federation:target-node": {
        "types": "./dist/selectors/env/node.d.ts",
        "import": "./dist/selectors/env/node.js",
        "require": "./dist/selectors/env/node.cjs",
        "default": "./dist/selectors/env/node.js"
      },
      "module-federation:target-worker": {
        "types": "./dist/selectors/env/worker.d.ts",
        "import": "./dist/selectors/env/worker.js",
        "require": "./dist/selectors/env/worker.cjs",
        "default": "./dist/selectors/env/worker.js"
      },
      "module-federation:target-universal": {
        "types": "./dist/selectors/env/universal.d.ts",
        "import": "./dist/selectors/env/universal.js",
        "require": "./dist/selectors/env/universal.cjs",
        "default": "./dist/selectors/env/universal.js"
      },
      "default": {
        "types": "./dist/selectors/env/legacy.d.ts",
        "import": "./dist/selectors/env/legacy.js",
        "require": "./dist/selectors/env/legacy.cjs",
        "default": "./dist/selectors/env/legacy.js"
      }
    },
    "#mf/platform-loader": {
      "module-federation:target-web": {
        "types": "./dist/selectors/platform-loader/web.d.ts",
        "import": "./dist/selectors/platform-loader/web.js",
        "require": "./dist/selectors/platform-loader/web.cjs",
        "default": "./dist/selectors/platform-loader/web.js"
      },
      "module-federation:target-node": {
        "types": "./dist/selectors/platform-loader/node.d.ts",
        "import": "./dist/selectors/platform-loader/node.js",
        "require": "./dist/selectors/platform-loader/node.cjs",
        "default": "./dist/selectors/platform-loader/node.js"
      },
      "module-federation:target-worker": {
        "types": "./dist/selectors/platform-loader/worker.d.ts",
        "import": "./dist/selectors/platform-loader/worker.js",
        "require": "./dist/selectors/platform-loader/worker.cjs",
        "default": "./dist/selectors/platform-loader/worker.js"
      },
      "module-federation:target-universal": {
        "types": "./dist/selectors/platform-loader/universal.d.ts",
        "import": "./dist/selectors/platform-loader/universal.js",
        "require": "./dist/selectors/platform-loader/universal.cjs",
        "default": "./dist/selectors/platform-loader/universal.js"
      },
      "default": {
        "types": "./dist/selectors/platform-loader/legacy.d.ts",
        "import": "./dist/selectors/platform-loader/legacy.js",
        "require": "./dist/selectors/platform-loader/legacy.cjs",
        "default": "./dist/selectors/platform-loader/legacy.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "normalize-webpack-path": [
        "./dist/normalize-webpack-path.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "webpack": "^5.0.0"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=false pnpm exec eslint --ignore-pattern node_modules \"**/*.ts\" \"package.json\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules pnpm exec jest --config jest.config.cjs --passWithNoTests",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules pnpm exec jest --config jest.config.cjs --passWithNoTests --ci --coverage",
    "pre-release": "pnpm run test && pnpm run build"
  }
}
