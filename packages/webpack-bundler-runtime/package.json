{
  "public": true,
  "name": "@module-federation/webpack-bundler-runtime",
  "version": "2.9.1",
  "type": "module",
  "license": "MIT",
  "description": "Module Federation Runtime for webpack",
  "keywords": [
    "Module Federation",
    "bundler runtime"
  ],
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/module-federation/core.git",
    "directory": "packages/webpack-bundler-runtime"
  },
  "author": "zhanghang <hanric.zhang@gmail.com>",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@module-federation/error-codes": "workspace:*",
    "@module-federation/runtime": "workspace:*",
    "@module-federation/sdk": "workspace:*"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./constant": {
      "import": {
        "types": "./dist/constant.d.ts",
        "default": "./dist/constant.js"
      },
      "require": {
        "types": "./dist/constant.d.cts",
        "default": "./dist/constant.cjs"
      }
    },
    "./bundler": "./dist/bundler.js",
    "./*": "./*"
  },
  "imports": {
    "#mf/remotes": {
      "module-federation:no-remote": {
        "types": "./dist/selectors/remotes/disabled.d.ts",
        "import": "./dist/selectors/remotes/disabled.js",
        "require": "./dist/selectors/remotes/disabled.cjs",
        "default": "./dist/selectors/remotes/disabled.js"
      },
      "default": {
        "types": "./dist/selectors/remotes/legacy.d.ts",
        "import": "./dist/selectors/remotes/legacy.js",
        "require": "./dist/selectors/remotes/legacy.cjs",
        "default": "./dist/selectors/remotes/legacy.js"
      }
    },
    "#mf/shared-runtime": {
      "module-federation:no-shared": {
        "types": "./dist/selectors/shared-runtime/disabled.d.ts",
        "import": "./dist/selectors/shared-runtime/disabled.js",
        "require": "./dist/selectors/shared-runtime/disabled.cjs",
        "default": "./dist/selectors/shared-runtime/disabled.js"
      },
      "default": {
        "types": "./dist/selectors/shared-runtime/legacy.d.ts",
        "import": "./dist/selectors/shared-runtime/legacy.js",
        "require": "./dist/selectors/shared-runtime/legacy.cjs",
        "default": "./dist/selectors/shared-runtime/legacy.js"
      }
    },
    "#mf/container-entry": {
      "module-federation:no-container-entry": {
        "types": "./dist/selectors/container-entry/disabled.d.ts",
        "import": "./dist/selectors/container-entry/disabled.js",
        "require": "./dist/selectors/container-entry/disabled.cjs",
        "default": "./dist/selectors/container-entry/disabled.js"
      },
      "default": {
        "types": "./dist/selectors/container-entry/legacy.d.ts",
        "import": "./dist/selectors/container-entry/legacy.js",
        "require": "./dist/selectors/container-entry/legacy.cjs",
        "default": "./dist/selectors/container-entry/legacy.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "constant": [
        "./dist/constant.d.ts"
      ],
      "bundler": [
        "./dist/bundler.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts --filter webpack-bundler-runtime-build",
    "lint": "ESLINT_USE_FLAT_CONFIG=false pnpm exec eslint --ignore-pattern node_modules \"**/*.ts\" \"package.json\"",
    "test": "pnpm exec jest --config jest.config.cjs --passWithNoTests",
    "test:ci": "pnpm exec jest --config jest.config.cjs --passWithNoTests --ci --coverage",
    "pre-release": "pnpm run test && pnpm run build"
  }
}
