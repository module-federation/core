{
  "public": true,
  "name": "@module-federation/webpack-bundler-runtime",
  "version": "2.9.1",
  "type": "module",
  "license": "MIT",
  "description": "Module Federation Runtime for webpack",
  "keywords": [
    "Module Federation",
    "bundler runtime"
  ],
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/module-federation/core.git",
    "directory": "packages/webpack-bundler-runtime"
  },
  "author": "zhanghang <hanric.zhang@gmail.com>",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@module-federation/error-codes": "workspace:*",
    "@module-federation/runtime": "workspace:*",
    "@module-federation/sdk": "workspace:*"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./compose": {
      "import": {
        "types": "./dist/compose.d.ts",
        "default": "./dist/compose.js"
      },
      "require": {
        "types": "./dist/compose.d.ts",
        "default": "./dist/compose.cjs"
      }
    },
    "./adapters/remotes": {
      "import": {
        "types": "./dist/adapters/remotes.d.ts",
        "default": "./dist/adapters/remotes.js"
      },
      "require": {
        "types": "./dist/adapters/remotes.d.ts",
        "default": "./dist/adapters/remotes.cjs"
      }
    },
    "./adapters/consumes": {
      "import": {
        "types": "./dist/adapters/consumes.d.ts",
        "default": "./dist/adapters/consumes.js"
      },
      "require": {
        "types": "./dist/adapters/consumes.d.ts",
        "default": "./dist/adapters/consumes.cjs"
      }
    },
    "./adapters/share-scope": {
      "import": {
        "types": "./dist/adapters/share-scope.d.ts",
        "default": "./dist/adapters/share-scope.js"
      },
      "require": {
        "types": "./dist/adapters/share-scope.d.ts",
        "default": "./dist/adapters/share-scope.cjs"
      }
    },
    "./adapters/container": {
      "import": {
        "types": "./dist/adapters/container.d.ts",
        "default": "./dist/adapters/container.js"
      },
      "require": {
        "types": "./dist/adapters/container.d.ts",
        "default": "./dist/adapters/container.cjs"
      }
    },
    "./constant": {
      "import": {
        "types": "./dist/constant.d.ts",
        "default": "./dist/constant.js"
      },
      "require": {
        "types": "./dist/constant.d.ts",
        "default": "./dist/constant.cjs"
      }
    },
    "./bundler": "./dist/bundler.js",
    "./*": "./*"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "constant": [
        "./dist/constant.d.ts"
      ],
      "bundler": [
        "./dist/bundler.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts --filter webpack-bundler-runtime-build",
    "lint": "ESLINT_USE_FLAT_CONFIG=false pnpm exec eslint --ignore-pattern node_modules \"**/*.ts\" \"package.json\"",
    "test": "pnpm exec jest --config jest.config.cjs --passWithNoTests",
    "test:ci": "pnpm exec jest --config jest.config.cjs --passWithNoTests --ci --coverage",
    "pre-release": "pnpm run test && pnpm run build"
  }
}
