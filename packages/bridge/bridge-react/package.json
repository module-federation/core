{
  "name": "@module-federation/bridge-react",
  "version": "2.9.2",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "author": "zhouxiao <codingzx@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/module-federation/core.git",
    "directory": "packages/bridge/bridge-react"
  },
  "files": [
    "dist/",
    "!dist/build-modules.*.json",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.node.mjs"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.node.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./base": {
      "node": {
        "import": {
          "types": "./dist/base.d.mts",
          "default": "./dist/base.node.mjs"
        },
        "require": {
          "types": "./dist/base.d.ts",
          "default": "./dist/base.node.cjs"
        }
      },
      "import": {
        "types": "./dist/base.d.mts",
        "default": "./dist/base.mjs"
      },
      "require": {
        "types": "./dist/base.d.ts",
        "default": "./dist/base.cjs"
      }
    },
    "./v18": {
      "import": {
        "types": "./dist/v18.d.mts",
        "default": "./dist/v18.mjs"
      },
      "require": {
        "types": "./dist/v18.d.ts",
        "default": "./dist/v18.cjs"
      }
    },
    "./v19": {
      "import": {
        "types": "./dist/v19.d.mts",
        "default": "./dist/v19.mjs"
      },
      "require": {
        "types": "./dist/v19.d.ts",
        "default": "./dist/v19.cjs"
      }
    },
    "./router": {
      "import": {
        "types": "./dist/router.d.mts",
        "default": "./dist/router.mjs"
      },
      "require": {
        "types": "./dist/router.d.ts",
        "default": "./dist/router.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./router-v5": {
      "import": {
        "types": "./dist/router-v5.d.mts",
        "default": "./dist/router-v5.mjs"
      },
      "require": {
        "types": "./dist/router-v5.d.ts",
        "default": "./dist/router-v5.cjs"
      }
    },
    "./router-v6": {
      "import": {
        "types": "./dist/router-v6.d.mts",
        "default": "./dist/router-v6.mjs"
      },
      "require": {
        "types": "./dist/router-v6.d.ts",
        "default": "./dist/router-v6.cjs"
      }
    },
    "./router-v7": {
      "import": {
        "types": "./dist/router-v7.d.mts",
        "default": "./dist/router-v7.mjs"
      },
      "require": {
        "types": "./dist/router-v7.d.ts",
        "default": "./dist/router-v7.cjs"
      }
    },
    "./lazy-utils": {
      "import": {
        "types": "./dist/lazy-utils.d.mts",
        "default": "./dist/lazy-utils.mjs"
      },
      "require": {
        "types": "./dist/lazy-utils.d.ts",
        "default": "./dist/lazy-utils.cjs"
      }
    },
    "./data-fetch-utils": {
      "import": {
        "types": "./dist/data-fetch-utils.d.mts",
        "default": "./dist/data-fetch-utils.mjs"
      },
      "require": {
        "types": "./dist/data-fetch-utils.d.ts",
        "default": "./dist/data-fetch-utils.cjs"
      }
    },
    "./data-fetch": {
      "import": {
        "types": "./dist/data-fetch.d.mts",
        "default": "./dist/data-fetch.mjs"
      },
      "require": {
        "types": "./dist/data-fetch.d.ts",
        "default": "./dist/data-fetch.cjs"
      }
    },
    "./data-fetch-server-middleware": {
      "import": {
        "types": "./dist/data-fetch-server-middleware.d.mts",
        "default": "./dist/data-fetch-server-middleware.mjs"
      },
      "require": {
        "types": "./dist/data-fetch-server-middleware.d.ts",
        "default": "./dist/data-fetch-server-middleware.cjs"
      }
    },
    "./lazy-load-component-plugin": {
      "import": {
        "types": "./dist/lazy-load-component-plugin.d.mts",
        "default": "./dist/lazy-load-component-plugin.mjs"
      },
      "require": {
        "types": "./dist/lazy-load-component-plugin.d.ts",
        "default": "./dist/lazy-load-component-plugin.cjs"
      }
    },
    "./size-limited-cache": {
      "import": {
        "types": "./dist/size-limited-cache.d.mts",
        "default": "./dist/size-limited-cache.mjs"
      },
      "require": {
        "types": "./dist/size-limited-cache.d.ts",
        "default": "./dist/size-limited-cache.cjs"
      }
    },
    "./dist/*.es.js": {
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    },
    "./dist/*.cjs.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.cjs"
    },
    "./*": "./*",
    "./ssr": {
      "import": {
        "types": "./dist/ssr.d.mts",
        "default": "./dist/ssr.mjs"
      },
      "require": {
        "types": "./dist/ssr.d.ts",
        "default": "./dist/ssr.cjs"
      }
    },
    "./ssr-node": {
      "import": {
        "types": "./dist/ssr-node.d.mts",
        "default": "./dist/ssr-node.mjs"
      },
      "require": {
        "types": "./dist/ssr-node.d.ts",
        "default": "./dist/ssr-node.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "base": [
        "./dist/base.d.ts"
      ],
      "v18": [
        "./dist/v18.d.ts"
      ],
      "v19": [
        "./dist/v19.d.ts"
      ],
      "router": [
        "./dist/router.d.ts"
      ],
      "plugin": [
        "./dist/plugin.d.ts"
      ],
      "router-v5": [
        "./dist/router-v5.d.ts"
      ],
      "router-v6": [
        "./dist/router-v6.d.ts"
      ],
      "router-v7": [
        "./dist/router-v7.d.ts"
      ],
      "lazy-load-component-plugin": [
        "./dist/lazy-load-component-plugin.d.ts"
      ],
      "lazy-utils": [
        "./dist/lazy-utils.d.ts"
      ],
      "data-fetch-utils": [
        "./dist/data-fetch-utils.d.ts"
      ],
      "data-fetch": [
        "./dist/data-fetch.d.ts"
      ],
      "data-fetch-server-middleware": [
        "./dist/data-fetch-server-middleware.d.ts"
      ],
      "size-limited-cache": [
        "./dist/size-limited-cache.d.ts"
      ],
      "ssr": [
        "./dist/ssr.d.ts"
      ],
      "ssr-node": [
        "./dist/ssr-node.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json && node scripts/write-dts-entrypoints.mjs",
    "preview": "vite preview",
    "test": "pnpm run test:jest && pnpm run test:rstest && pnpm run test:types && pnpm run test:ssr-entries && pnpm run test:boundaries && pnpm run test:compatibility",
    "test:jest": "pnpm exec jest --config jest.config.js --passWithNoTests",
    "test:rstest": "pnpm exec rstest --passWithNoTests && pnpm exec rstest --config rstest.ssr.config.ts",
    "test:types": "node scripts/check-react-remote-types.mjs",
    "test:ssr-entries": "node scripts/check-bridge-ssr-entries.mjs",
    "test:boundaries": "node scripts/check-runtime-boundaries.mjs",
    "test:compatibility": "node ../../../scripts/check-bridge-alias-compatibility.mjs"
  },
  "dependencies": {
    "@module-federation/bridge-shared": "workspace:*",
    "@module-federation/sdk": "workspace:*",
    "acorn": "8.15.0"
  },
  "peerDependencies": {
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0",
    "react-router-dom": "^4 || ^5 || ^6 || ^7",
    "react-router": "^6 || ^7",
    "@module-federation/enhanced": "workspace:^"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "2.1.0",
    "@testing-library/react": "15.0.7",
    "@testing-library/jest-dom": "6.6.3",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "react-router": "7.18.2",
    "typescript": "7.0.2",
    "vite": "^5.4.21",
    "hono": "4.13.5",
    "@module-federation/enhanced": "workspace:*",
    "jsdom": "20.0.3",
    "@types/jsdom": "20.0.1",
    "htmlparser2": "10.0.0"
  }
}
