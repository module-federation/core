{
  "name": "@module-federation/bridge-vue3",
  "author": "zhouxiao <codingzx@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/module-federation/core.git",
    "directory": "packages/bridge/vue3-bridge"
  },
  "version": "2.8.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "node": {
        "import": "./dist/index.server.js",
        "require": "./dist/index.server.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": "./*"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json",
    "preview": "vite preview",
    "test": "rstest"
  },
  "peerDependencies": {
    "vue": "=3",
    "vue-router": "=4",
    "@vue/server-renderer": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/server-renderer": {
      "optional": true
    }
  },
  "dependencies": {
    "@module-federation/bridge-shared": "workspace:*",
    "@module-federation/runtime": "workspace:*",
    "@module-federation/sdk": "workspace:*"
  },
  "devDependencies": {
    "@rsbuild/plugin-babel": "2.0.1",
    "@rsbuild/plugin-vue-jsx": "2.0.1",
    "@types/react": "^18.3.11",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "typescript": "7.0.2",
    "vite": "^5.4.21",
    "vue": "^3.5.30",
    "vue-router": "4.4.5",
    "@vue/server-renderer": "^3.5.30",
    "vue-tsc": "^2.2.12"
  }
}
