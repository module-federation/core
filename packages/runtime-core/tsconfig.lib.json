{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": ["node"],
    "paths": {
      "#mf/remote-module": ["./src/selectors/remote-module/legacy.ts"],
      "#mf/remote-entry": ["./src/selectors/remote-entry/legacy.ts"],
      "#mf/remote-handler": ["./src/selectors/remote-handler/legacy.ts"],
      "#mf/shared-handler": ["./src/selectors/shared-handler/legacy.ts"],
      "#mf/snapshot-handler": ["./src/selectors/snapshot-handler/legacy.ts"],
      "#mf/default-plugins": ["./src/selectors/default-plugins/legacy.ts"],
      "#mf/share-config": ["./src/selectors/share-config/legacy.ts"],
      "#mf/share-utils": ["./src/selectors/share-utils/legacy.ts"],
      "#mf/preload": ["./src/selectors/preload/legacy.ts"],
      "*": ["./*"]
    }
  },
  "include": ["src/**/*.ts", "global.d.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
