{
  "name": "@module-federation/rstest",
  "version": "2.9.0",
  "description": "Module Federation plugin for Rstest.",
  "homepage": "https://module-federation.io",
  "bugs": {
    "url": "https://github.com/module-federation/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/module-federation/core.git",
    "directory": "packages/rstest"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rslib build",
    "lint": "ESLINT_USE_FLAT_CONFIG=false pnpm exec eslint --ignore-pattern node_modules \"**/*.{ts,mts,cts}\" \"package.json\"",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:consumer && pnpm run test:integration",
    "test:unit": "pnpm exec rstest run -c rstest.config.ts",
    "test:consumer": "pnpm exec tsc -p tests/consumer/tsconfig.json",
    "test:integration": "pnpm exec rstest run -c tests/integration/rstest.config.ts",
    "pre-release": "pnpm run test"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "workspace:*",
    "@rslib/core": "^0.23.2",
    "@rsbuild/core": "2.1.4",
    "@rstest/core": "0.11.6",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@rstest/core": ">=0.11.4",
    "@rsbuild/core": "^1.3.21 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rstest/core": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@module-federation/enhanced": "workspace:*",
    "@module-federation/node": "workspace:*",
    "@module-federation/sdk": "workspace:*"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
