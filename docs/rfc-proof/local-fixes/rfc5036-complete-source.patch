--- a/packages/runtime-core/src/runtimeImage.ts
+++ b/packages/runtime-core/src/runtimeImage.ts
@@ -14,0 +15,56 @@ export interface RuntimeImageDescriptorV1 {
+function isNonemptyString(value: unknown): value is string {
+  return typeof value === 'string' && value.trim().length > 0;
+}
+
+function isCapabilityList(value: unknown): value is readonly string[] {
+  if (!Array.isArray(value)) return false;
+  for (const capability of value) {
+    if (!isNonemptyString(capability)) return false;
+  }
+  return true;
+}
+
+function isRuntimeImageDescriptorV1(
+  value: unknown,
+): value is RuntimeImageDescriptorV1 {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    !Array.isArray(value) &&
+    'contract' in value &&
+    value.contract === 1 &&
+    'compatibilityId' in value &&
+    isNonemptyString(value.compatibilityId) &&
+    'target' in value &&
+    isNonemptyString(value.target) &&
+    'entryLoadingIdentity' in value &&
+    isNonemptyString(value.entryLoadingIdentity) &&
+    'required' in value &&
+    isCapabilityList(value.required) &&
+    'forbidden' in value &&
+    isCapabilityList(value.forbidden) &&
+    'available' in value &&
+    isCapabilityList(value.available)
+  );
+}
+
+export function parseRuntimeImage(
+  value: unknown,
+): RuntimeImageDescriptorV1 | undefined {
+  // Only undefined denotes an untagged legacy image. Falsy supplied metadata
+  // must not bypass validation or become a compatibility opt-out.
+  if (value === undefined) return undefined;
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    error('[RuntimeImageContract] Invalid runtime-image descriptor.');
+  }
+  if (!('contract' in value) || value.contract !== 1) {
+    error(
+      '[RuntimeImageContract] Unsupported runtime-image contract; expected 1.',
+    );
+  }
+  if (!isRuntimeImageDescriptorV1(value)) {
+    error('[RuntimeImageContract] Invalid runtime-image descriptor fields.');
+  }
+  return value;
+}
