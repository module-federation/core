@@ -0,0 +1,306 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { createRequire } from 'node:module';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+const require = createRequire(import.meta.url);
+const script = fileURLToPath(import.meta.url);
+const [action, dir, mode] = process.argv.slice(2);
+
+if (action === 'execute') {
+  let provider;
+  if (mode !== 'missing') {
+    provider = require(path.join(dir, 'out/provider.cjs')).default;
+    assert.ok(provider.instance);
+    assert.equal(
+      provider.instance.constructor,
+      globalThis._FEDERATION_RUNTIME_CORE.ModuleFederation,
+    );
+    assert.ok(
+      provider.instance instanceof
+        globalThis._FEDERATION_RUNTIME_CORE.ModuleFederation,
+    );
+  }
+  const publication = globalThis._FEDERATION_RUNTIME_CORE_FROM;
+  const core = globalThis._FEDERATION_RUNTIME_CORE;
+  if (mode === 'kernel')
+    globalThis._FEDERATION_RUNTIME_CORE = {
+      ...core,
+      FederationKernel: undefined,
+    };
+  if (mode === 'global')
+    globalThis._FEDERATION_RUNTIME_CORE = { ...core, CurrentGlobal: {} };
+  if (mode === 'helper')
+    globalThis._FEDERATION_RUNTIME_CORE = {
+      ...core,
+      getRemoteEntry: undefined,
+    };
+  if (mode === 'old-provider')
+    globalThis._FEDERATION_RUNTIME_CORE = require(
+      process.env.PROOF_OLD_CORE_PATH,
+    );
+  const injectedCore = globalThis._FEDERATION_RUNTIME_CORE;
+  const registry = globalThis.__FEDERATION__;
+  const instances = registry?.__INSTANCES__;
+  const instanceSnapshot = instances ? [...instances] : undefined;
+  const cloneShareState = (value) => {
+    if (Array.isArray(value)) return value.map(cloneShareState);
+    if (
+      value &&
+      typeof value === 'object' &&
+      Object.getPrototypeOf(value) === Object.prototype
+    ) {
+      return Object.fromEntries(
+        Object.entries(value).map(([key, entry]) => [
+          key,
+          cloneShareState(entry),
+        ]),
+      );
+    }
+    return value;
+  };
+  const shareSnapshot = cloneShareState(registry?.__SHARE__);
+  const expected = {
+    missing: 'must publish a core namespace',
+    kernel: 'missing callable "FederationKernel"',
+    'old-provider': 'missing callable "FederationKernel"',
+    global: 'missing the federation instance registry',
+    helper: 'missing callable "getRemoteEntry"',
+  };
+  if (mode !== 'compatible') {
+    assert.throws(
+      () => require(path.join(dir, 'out/consumer.cjs')),
+      (error) =>
+        error.message.includes('[ExternalRuntimeKernelContract]') &&
+        error.message.includes(expected[mode]),
+    );
+    assert.equal(globalThis._FEDERATION_RUNTIME_CORE_FROM, publication);
+    assert.equal(globalThis._FEDERATION_RUNTIME_CORE, injectedCore);
+    if (registry) {
+      assert.equal(globalThis.__FEDERATION__, registry);
+      assert.equal(registry.__INSTANCES__, instances);
+      assert.deepEqual(registry.__INSTANCES__, instanceSnapshot);
+      assert.deepEqual(registry.__SHARE__, shareSnapshot);
+    }
+    console.log(
+      JSON.stringify({
+        mode,
+        rejected: expected[mode],
+        publicationUnchanged: true,
+        registryAndShareUnchanged: Boolean(registry),
+      }),
+    );
+  } else {
+    const consumer = await require(path.join(dir, 'out/consumer.cjs')).default;
+    assert.ok(consumer.instance);
+    assert.equal(consumer.instance.constructor, core.ModuleFederation);
+    assert.ok(consumer.instance instanceof core.ModuleFederation);
+    assert.equal(consumer.shared.literal, 'shared-provider-literal');
+    assert.equal(consumer.remote.literal, 'remote-file-literal');
+    assert.equal(consumer.shared, consumer.remote.shared);
+    const entry =
+      'data:text/javascript,' +
+      encodeURIComponent(
+        "module.exports={init(){},get(){return Promise.resolve(()=>({default:'runtime-data-url-remote-literal'}));}};",
+      );
+    consumer.instance.registerRemotes([
+      {
+        name: 'dataRemote',
+        entry,
+        type: 'commonjs',
+        entryGlobalName: 'dataRemote',
+      },
+    ]);
+    const remote = await consumer.instance.loadRemote('dataRemote/literal');
+    assert.equal(remote.default, 'runtime-data-url-remote-literal');
+    assert.equal(globalThis._FEDERATION_RUNTIME_CORE, core);
+    assert.equal(globalThis._FEDERATION_RUNTIME_CORE_FROM, publication);
+    console.log(
+      JSON.stringify({
+        mode,
+        instance: true,
+        constructorIdentity: true,
+        sharedLiteral: consumer.shared.literal,
+        fileRemoteLiteral: consumer.remote.literal,
+        runtimeRemoteLiteral: remote.default,
+        sharedIdentity: true,
+      }),
+    );
+  }
+} else {
+  const imported = process.env.PROOF_RSPACK_CORE_PATH
+    ? require(process.env.PROOF_RSPACK_CORE_PATH)
+    : await import('@rspack/core');
+  const rspack = imported.rspack ?? imported.default.rspack;
+  const { ModuleFederationPlugin } = require('../../dist/index.js');
+  fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(path.join(dir, 'package.json'), '{"private":true}');
+  fs.writeFileSync(
+    path.join(dir, 'shared.js'),
+    "module.exports={literal:'shared-provider-literal',marker:{}};",
+  );
+  fs.writeFileSync(
+    path.join(dir, 'provider.js'),
+    "import shared from 'proof-shared';export default {shared,instance:__webpack_require__.federation.instance};",
+  );
+  fs.writeFileSync(
+    path.join(dir, 'remote.js'),
+    "import shared from 'proof-shared';export default {shared,literal:'remote-file-literal'};",
+  );
+  fs.writeFileSync(
+    path.join(dir, 'consumer.js'),
+    "import shared from 'proof-shared';export default import('remote/literal').then(({default:remote})=>({shared,remote,instance:__webpack_require__.federation.instance}));",
+  );
+  fs.writeFileSync(
+    path.join(dir, 'unsupported.js'),
+    "import {shared} from '@module-federation/runtime-core/shared';export default shared;",
+  );
+  const config = (name, entry, options) => ({
+    mode: 'development',
+    target: 'async-node',
+    context: dir,
+    devtool: false,
+    entry: entry ? path.join(dir, entry) : {},
+    output: {
+      path: path.join(dir, 'out'),
+      filename: name + '.cjs',
+      uniqueName: name,
+      publicPath: '',
+      library: { type: 'commonjs-module' },
+    },
+    resolve: {
+      modules: [
+        path.resolve(path.dirname(script), '../../node_modules'),
+        'node_modules',
+      ],
+    },
+    externalsType: 'global',
+    optimization: { minimize: false },
+    performance: false,
+    plugins: [
+      new ModuleFederationPlugin({
+        name,
+        dts: false,
+        manifest: false,
+        shared: {
+          'proof-shared': {
+            import: path.join(dir, 'shared.js'),
+            eager: true,
+            singleton: true,
+            version: '1.0.0',
+            requiredVersion: false,
+          },
+        },
+        ...options,
+      }),
+    ],
+  });
+  const compile = (config) =>
+    new Promise((resolve, reject) => {
+      const compiler = rspack(config);
+      compiler.run((error, stats) =>
+        compiler.close(() => {
+          if (error) return reject(error);
+          const graph = new Set();
+          for (const chunk of stats.compilation.chunks)
+            for (const module of stats.compilation.chunkGraph.getChunkModulesIterable(
+              chunk,
+            ))
+              for (const nested of [module, ...(module.modules ?? [])]) {
+                const resource = nested.nameForCondition?.();
+                if (resource?.includes('/runtime-core/dist/'))
+                  graph.add(resource);
+              }
+          const json = stats.toJson({
+            all: false,
+            errors: true,
+            warnings: true,
+          });
+          resolve({ ...json, coreModules: [...graph].sort() });
+        }),
+      );
+    });
+  const results = [];
+  results.push(
+    await compile(
+      config('provider', 'provider.js', {
+        experiments: { provideExternalRuntime: true },
+      }),
+    ),
+  );
+  results.push(
+    await compile(
+      config('remote', null, {
+        filename: 'remoteEntry.cjs',
+        library: { type: 'commonjs-module' },
+        exposes: { './literal': path.join(dir, 'remote.js') },
+        experiments: { externalRuntime: true },
+      }),
+    ),
+  );
+  results.push(
+    await compile(
+      config('consumer', 'consumer.js', {
+        remotes: {
+          remote: `promise Promise.resolve(require(${JSON.stringify(path.join(dir, 'out/remoteEntry.cjs'))}))`,
+        },
+        experiments: { externalRuntime: true },
+      }),
+    ),
+  );
+  for (const result of results) assert.deepEqual(result.errors, []);
+  fs.writeFileSync(
+    path.join(dir, 'graphs.json'),
+    JSON.stringify({ results }, null, 2),
+  );
+  assert.ok(results[0].coreModules.length > 0);
+  assert.deepEqual(results[1].coreModules, []);
+  assert.deepEqual(results[2].coreModules, []);
+  const unsupported = await compile(
+    config('unsupported', 'unsupported.js', {
+      experiments: { externalRuntime: true },
+    }),
+  );
+  assert.ok(
+    unsupported.errors.some(
+      (error) =>
+        error.message.includes('[ExternalRuntimeNamespace]') &&
+        error.message.includes('@module-federation/runtime-core/shared'),
+    ),
+  );
+  fs.writeFileSync(
+    path.join(dir, 'graphs.json'),
+    JSON.stringify({ results, unsupported }, null, 2),
+  );
+  const modes = [
+    'compatible',
+    'missing',
+    'kernel',
+    'global',
+    'helper',
+    ...(process.env.PROOF_OLD_CORE_PATH ? ['old-provider'] : []),
+  ];
+  const startups = [];
+  for (const mode of modes) {
+    const result = spawnSync(process.execPath, [script, 'execute', dir, mode], {
+      encoding: 'utf8',
+      timeout: 30000,
+    });
+    fs.writeFileSync(
+      path.join(dir, mode + '.log'),
+      result.stdout + result.stderr,
+    );
+    assert.equal(result.status, 0, result.stdout + result.stderr);
+    startups.push(JSON.parse(result.stdout.trim()));
+  }
+  console.log(
+    'RESULT ' +
+      JSON.stringify({
+        coreModules: results.map((result) => result.coreModules.length),
+        unsupportedNamespaceRejected: true,
+        startups,
+      }),
+  );
+}
