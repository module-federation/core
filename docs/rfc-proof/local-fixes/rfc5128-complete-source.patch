+---
+'@module-federation/rspack': patch
+---
+
+Reuse the external runtime provider's validated kernel namespace without bundling a second runtime core. Report unsupported runtime-core subpaths when external runtime is enabled.
diff --git a/packages/rspack/__tests__/ExternalRuntimePlugin.spec.ts b/packages/rspack/__tests__/ExternalRuntimePlugin.spec.ts
new file mode 100644
index 000000000..caf11fb9b
--- /dev/null
+++ b/packages/rspack/__tests__/ExternalRuntimePlugin.spec.ts
@@ -0,0 +1,73 @@
+import { runInNewContext } from 'node:vm';
+import { externalKernelBody } from '../src/ExternalRuntimePlugin';
+
+function evaluate(core: unknown): unknown {
+  const module: { exports: unknown } = { exports: undefined };
+  runInNewContext(externalKernelBody + '\nmodule.exports = kernel;', {
+    core,
+    module,
+  });
+  return module.exports;
+}
+
+const provider = () => ({
+  FederationKernel: () => {},
+  CurrentGlobal: { __FEDERATION__: { __INSTANCES__: [] } },
+  getGlobalSnapshotInfoByModuleInfo: () => {},
+  getRemoteEntry: () => {},
+  setGlobalFederationInstance: () => {},
+  ModuleFederation: () => {},
+});
+
+describe('external kernel namespace', () => {
+  it('projects the kernel exports with their actual provider identities', () => {
+    const core = provider();
+    expect(evaluate(core)).toEqual({
+      FederationKernel: core.FederationKernel,
+      CurrentGlobal: core.CurrentGlobal,
+      getGlobalSnapshotInfoByModuleInfo: core.getGlobalSnapshotInfoByModuleInfo,
+      getRemoteEntry: core.getRemoteEntry,
+      setGlobalFederationInstance: core.setGlobalFederationInstance,
+    });
+  });
+
+  it.each([undefined, null, false])(
+    'rejects an absent or invalid namespace before reading exports: %p',
+    (core) => {
+      expect(() => evaluate(core)).toThrow(
+        '[ExternalRuntimeKernelContract] The external runtime provider must publish a core namespace.',
+      );
+    },
+  );
+
+  it('rejects a historical provider without the new kernel constructor', () => {
+    expect(() =>
+      evaluate({ ...provider(), FederationKernel: undefined }),
+    ).toThrow(
+      '[ExternalRuntimeKernelContract] The external runtime provider is missing callable "FederationKernel".',
+    );
+  });
+
+  it('rejects a missing helper instead of exporting a placeholder', () => {
+    expect(() =>
+      evaluate({ ...provider(), getRemoteEntry: undefined }),
+    ).toThrow(
+      '[ExternalRuntimeKernelContract] The external runtime provider is missing callable "getRemoteEntry".',
+    );
+  });
+
+  it('rejects an invalid global before publishing the kernel namespace', () => {
+    expect(() => evaluate({ ...provider(), CurrentGlobal: null })).toThrow(
+      '[ExternalRuntimeKernelContract] The external runtime provider is missing object "CurrentGlobal".',
+    );
+  });
+
+  it.each([{}, { __FEDERATION__: {} }, { __FEDERATION__: [] }])(
+    'rejects malformed instance registry state: %p',
+    (CurrentGlobal) => {
+      expect(() => evaluate({ ...provider(), CurrentGlobal })).toThrow(
+        '[ExternalRuntimeKernelContract] The external runtime provider is missing the federation instance registry.',
+      );
+    },
+  );
+});
diff --git a/packages/rspack/__tests__/external-runtime-fixture/probe.mjs b/packages/rspack/__tests__/external-runtime-fixture/probe.mjs
