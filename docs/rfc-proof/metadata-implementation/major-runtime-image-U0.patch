+    assert.equal(result.errors.length, 0, name + JSON.stringify(result.errors));
+    if (!name.startsWith('provider-') && name !== 'producer')
+      assert.equal(
+        result.coreModules.length,
+        0,
+        name + ' contains bundled core',
+      );
+  }
+  fs.writeFileSync(
+    path.join(dir, 'graphs.json'),
+    JSON.stringify(results, null, 2),
+  );
+  const modes = [
+    'compatible',
+    'captured-defines',
+    'both-absent',
+    'provider-only',
+    'consumer-only',
+    'abi',
+    'target',
+    'loader',
+    'capability',
+    'forbidden',
+    'options-forbidden',
+    'supplied-late-hook',
+    'transport-tagged',
+    'transport-legacy',
+    'publication-info-null',
+    'publication-info-array',
+    'malformed-info-null',
+    'malformed-info-array',
+    ...['null', 'array', 'version', 'field', 'sparse'].flatMap((key) => [
+      'malformed-' + key,
+      'publication-' + key,
+      'supplied-config-' + key,
+      'supplied-options-' + key,
+    ]),
+    ...[
+      'ModuleFederation',
+      'getGlobalFederationConstructor',
+      'setGlobalFederationConstructor',
+      'Global',
+    ].map((key) => 'root-' + key),
+  ];
+  if (process.env.PROOF_OLD_KERNEL_CORE_PATH)
+    modes.push('old7aca-legacy', 'old7aca-tagged');
+  if (process.env.PROOF_OLD_KERNEL_PROVIDER_PATH)
+    modes.push('publication-old7aca');
+  if (process.env.PROOF_OLD_CORE_PATH) modes.push('old94aa-tagged');
+  for (const mode of modes) {
+    const row = spawnSync(process.execPath, [script, 'execute', dir, mode], {
+      env: process.env,
+      encoding: 'utf8',
+      timeout: 30000,
+    });
+    fs.writeFileSync(path.join(dir, mode + '.log'), row.stdout + row.stderr);
+    assert.equal(row.status, 0, mode + '\n' + row.stdout + row.stderr);
+    process.stdout.write(row.stdout);
+  }
+  // A direct root import must run the same early guard, independently of kernel.
+  const direct = spawnSync(
+    process.execPath,
+    [
+      '-e',
+      `const assert=require('node:assert/strict');require(${JSON.stringify(path.join(dir, 'out/provider-tagged.cjs'))});globalThis._FEDERATION_RUNTIME_CORE_FROM.runtimeImage={...globalThis._FEDERATION_RUNTIME_CORE_FROM.runtimeImage,contract:2};const core=globalThis._FEDERATION_RUNTIME_CORE,from=globalThis._FEDERATION_RUNTIME_CORE_FROM,registry=globalThis.__FEDERATION__,instances=[...registry.__INSTANCES__],shares=JSON.stringify(registry.__SHARE__);assert.throws(()=>require(${JSON.stringify(path.join(dir, 'out/direct-root.cjs'))}),/RuntimeImageContract/);assert.equal(globalThis._FEDERATION_RUNTIME_CORE,core);assert.equal(globalThis._FEDERATION_RUNTIME_CORE_FROM,from);assert.equal(globalThis.__FEDERATION__,registry);assert.deepEqual(registry.__INSTANCES__,instances);assert.equal(JSON.stringify(registry.__SHARE__),shares);console.log('direct-root rejected with state unchanged');`,
+    ],
+    { encoding: 'utf8' },
+  );
+  assert.equal(direct.status, 0, direct.stderr);
+  console.log(
+    JSON.stringify({
+      compiled: Object.keys(results).length,
+      processes: modes.length + 1,
+      directRootGuard: true,
+      coreCounts: Object.fromEntries(
+        Object.entries(results).map(([k, v]) => [k, v.coreModules.length]),
+      ),
+    }),
+  );
+}
