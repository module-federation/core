--- /dev/null
+++ b/packages/rspack/src/RuntimeImageProfile.ts
@@ -0,0 +1,60 @@
+import type { moduleFederationPlugin } from '@module-federation/sdk';
+import {
+  parseRuntimeImage,
+  type RuntimeImageDescriptorV1,
+} from '@module-federation/runtime-tools/runtime-core';
+
+type Options = moduleFederationPlugin.ModuleFederationPluginOptions;
+
+/** Describe this wrapper's known legacy runtime, not an opaque implementation. */
+export function deriveRuntimeImage(
+  options: Options,
+): RuntimeImageDescriptorV1 | undefined {
+  const profile = options.experiments?.runtimeImage;
+  if (profile === undefined) return undefined;
+  const fail = (message: string): never => {
+    throw new Error('[RuntimeImageDerivation] ' + message);
+  };
+  if (
+    typeof profile !== 'object' ||
+    profile === null ||
+    Array.isArray(profile)
+  ) {
+    return fail(
+      'Expected explicit compatibilityId and entryLoadingIdentity guarantees.',
+    );
+  }
+  if (
+    options.experiments?.externalRuntime !== true &&
+    options.experiments?.provideExternalRuntime !== true
+  ) {
+    return fail(
+      'Runtime-image profiles currently require externalRuntime or provideExternalRuntime; composed runtime profiles are unavailable.',
+    );
+  }
+  if (options.implementation || options.runtimePlugins?.length) {
+    return fail(
+      'Custom runtime implementations and runtime plugins have unknown capability or loader requirements.',
+    );
+  }
+  const optimization = options.experiments?.optimization;
+  const target = optimization?.target;
+  if (target !== 'web' && target !== 'node') {
+    return fail(
+      'Set experiments.optimization.target explicitly to web or node; compiler.target does not determine the runtime entry loader.',
+    );
+  }
+  // External/provide builds select the full legacy facade in this major.
+  // Historical disable flags do not remove any family from that facade.
+  const available = ['shared', 'remote', 'snapshot', 'platform'];
+  const forbidden: string[] = [];
+  return parseRuntimeImage({
+    contract: 1,
+    compatibilityId: profile.compatibilityId,
+    entryLoadingIdentity: profile.entryLoadingIdentity,
+    target,
+    required: available,
+    available,
+    forbidden,
+  });
+}
