+  results['consumer-forbidden'] = await compile(
+    config('consumer-forbidden', 'consumer.js', {
+      experiments: experiments('externalRuntime', true, {
+        disableSnapshot: true,
+      }),
+      remotes: { remote: remote(true) },
+    }),
+  );
+  results['consumer-commonjs'] = await compile(
+    config(
+      'consumer-commonjs',
+      'consumer.js',
+      {
+        experiments: experiments('externalRuntime', false),
+        remotes: { remote: remote(false) },
+      },
+      'commonjs',
+    ),
+  );
+  results['direct-commonjs'] = await compile(
+    config(
+      'direct-commonjs',
+      'direct-commonjs.js',
+      { experiments: experiments('externalRuntime', false) },
+      'commonjs',
+    ),
+  );
+  let flagReads = 0,
+    targetReads = 0;
+  const captured = {
+    get target() {
+      targetReads++;
+      return targetReads === 1 ? 'node' : 'web';
+    },
+    get disableRemote() {
+      flagReads++;
+      return flagReads === 1 ? false : true;
+    },
+  };
+  results['provider-captured'] = await compile(
