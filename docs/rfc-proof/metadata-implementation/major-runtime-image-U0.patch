+import { deriveRuntimeImage } from '../src/RuntimeImageProfile';
+import type { moduleFederationPlugin } from '@module-federation/sdk';
+const options = (): moduleFederationPlugin.ModuleFederationPluginOptions => ({
+  name: 'profile',
+  dts: false,
+  experiments: {
+    externalRuntime: true,
+    runtimeImage: { compatibilityId: 'abi', entryLoadingIdentity: 'loader' },
+    optimization: { target: 'node' },
+  },
+});
+
+it('describes the full legacy facade despite historical disable flags', () => {
+  const full = {
+    required: ['shared', 'remote', 'snapshot', 'platform'],
+    available: ['shared', 'remote', 'snapshot', 'platform'],
+    forbidden: [],
+    target: 'node',
+  };
+  expect(deriveRuntimeImage(options())).toMatchObject(full);
+  const ignored = options();
+  for (const flag of ['disableShared', 'disableRemote', 'disableSnapshot']) {
+    Reflect.set(ignored.experiments!.optimization!, flag, true);
+  }
+  expect(deriveRuntimeImage(ignored)).toMatchObject(full);
+});
+
+it('rejects missing explicit guarantees and opaque implementations/plugins', () => {
+  const noTarget = options();
+  delete noTarget.experiments!.optimization!.target;
+  expect(() => deriveRuntimeImage(noTarget)).toThrow('target explicitly');
+  expect(() =>
+    deriveRuntimeImage({ ...options(), implementation: 'opaque' }),
+  ).toThrow('unknown capability');
+  expect(() =>
+    deriveRuntimeImage({ ...options(), runtimePlugins: ['opaque'] }),
+  ).toThrow('unknown capability');
+  const composed = options();
+  delete composed.experiments!.externalRuntime;
+  expect(() => deriveRuntimeImage(composed)).toThrow(
+    'composed runtime profiles are unavailable',
+  );
+});
