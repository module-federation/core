+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { createRequire } from 'node:module';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+const require = createRequire(import.meta.url);
+const script = fileURLToPath(import.meta.url);
+const [action, dir, mode] = process.argv.slice(2);
+const full = {
+  contract: 1,
+  compatibilityId: 'abi-v1',
+  entryLoadingIdentity: 'sdk-node-v1',
+  target: 'node',
+  required: ['shared', 'remote', 'snapshot', 'platform'],
+  available: ['shared', 'remote', 'snapshot', 'platform'],
+  forbidden: [],
+};
+const profile = {
+  compatibilityId: full.compatibilityId,
+  entryLoadingIdentity: full.entryLoadingIdentity,
+};
+const clone = (value) =>
+  Array.isArray(value)
+    ? value.map(clone)
+    : value &&
+        typeof value === 'object' &&
+        Object.getPrototypeOf(value) === Object.prototype
+      ? Object.fromEntries(Object.entries(value).map(([k, v]) => [k, clone(v)]))
+      : value;
+const snap = () => ({
+  core: globalThis._FEDERATION_RUNTIME_CORE,
+  from: globalThis._FEDERATION_RUNTIME_CORE_FROM,
+  registry: globalThis.__FEDERATION__,
+  instances: globalThis.__FEDERATION__?.__INSTANCES__,
+  contents: [...(globalThis.__FEDERATION__?.__INSTANCES__ ?? [])],
+  shares: clone(globalThis.__FEDERATION__?.__SHARE__),
+});
+const unchanged = (before) => {
+  assert.equal(globalThis._FEDERATION_RUNTIME_CORE, before.core);
+  assert.equal(globalThis._FEDERATION_RUNTIME_CORE_FROM, before.from);
+  assert.equal(globalThis.__FEDERATION__, before.registry);
+  assert.equal(globalThis.__FEDERATION__.__INSTANCES__, before.instances);
+  assert.deepEqual(globalThis.__FEDERATION__.__INSTANCES__, before.contents);
+  assert.deepEqual(globalThis.__FEDERATION__.__SHARE__, before.shares);
+};
+if (action === 'execute') {
+  const warnings = [];
+  const traces = [];
+  const original = console.warn;
+  console.warn = (...args) => {
+    warnings.push(args.join(' '));
+    traces.push(new Error(args.join(' ')).stack);
+  };
+  const publication = mode.startsWith('publication-');
+  const supplied = mode.startsWith('supplied-');
+  const override = mode === 'options-forbidden';
+  const lateHook = mode === 'supplied-late-hook';
+  let provider;
+  if (mode === 'publication-old7aca') {
+    provider = require(process.env.PROOF_OLD_KERNEL_PROVIDER_PATH).default;
+  } else if (publication || supplied) {
+    require('../../../runtime-core/dist/index.cjs');
+  } else if (
+    mode.startsWith('old7aca-') &&
+    process.env.PROOF_OLD_KERNEL_PROVIDER_PATH
+  )
+    provider = require(process.env.PROOF_OLD_KERNEL_PROVIDER_PATH).default;
+  else if (mode === 'captured-defines')
+    provider = require(path.join(dir, 'out/provider-captured.cjs')).default;
+  else
+    provider = require(
+      path.join(
+        dir,
+        'out',
+        mode === 'both-absent' ||
+          mode === 'consumer-only' ||
+          mode === 'old7aca-legacy' ||
+          mode === 'transport-legacy' ||
+          mode === 'captured-defines'
+          ? 'provider-untagged.cjs'
+          : 'provider-tagged.cjs',
+      ),
+    ).default;
+  if (mode === 'transport-legacy')
+    globalThis._FEDERATION_RUNTIME_CORE = {
+      ...globalThis._FEDERATION_RUNTIME_CORE,
+      customExtra: 'preserved-extra-export',
+    };
+  const current = globalThis._FEDERATION_RUNTIME_CORE_FROM;
+  const core = globalThis._FEDERATION_RUNTIME_CORE;
+  let expected;
+  const invalid = {
+    null: null,
+    array: [],
+    version: { ...full, contract: 2 },
+    field: { ...full, target: '' },
+    sparse: { ...full, required: new Array(1) },
+  };
+  if (mode === 'publication-old7aca') {
+    expected = '[RuntimeImageMinimumContract]';
+  } else if (mode.includes('-info-')) {
+    globalThis._FEDERATION_RUNTIME_CORE_FROM = mode.endsWith('null')
+      ? null
+      : [];
+    expected = '[RuntimeImageContract]';
+  } else if (supplied) {
+    expected = '[RuntimeImageContract]';
+  } else if (publication) {
+    const payload = invalid[mode.slice('publication-'.length)];
+    globalThis._FEDERATION_RUNTIME_CORE_FROM = {
+      name: 'injected',
+      version: 'injected',
+      runtimeImage: payload,
+    };
+    expected = '[RuntimeImageContract]';
+  } else if (mode.startsWith('malformed-')) {
+    globalThis._FEDERATION_RUNTIME_CORE_FROM = {
+      ...current,
+      runtimeImage: invalid[mode.slice('malformed-'.length)],
+    };
+    expected = '[RuntimeImageContract]';
+  } else if (mode === 'abi') {
+    globalThis._FEDERATION_RUNTIME_CORE_FROM = {
+      ...current,
+      runtimeImage: { ...full, compatibilityId: 'different' },
+    };
+    expected = 'runtime state';
+  } else if (mode === 'target') {
+    globalThis._FEDERATION_RUNTIME_CORE_FROM = {
+      ...current,
+      runtimeImage: { ...full, target: 'web' },
+    };
+    expected = 'runtime image';
+  } else if (mode === 'loader') {
+    globalThis._FEDERATION_RUNTIME_CORE_FROM = {
+      ...current,
+      runtimeImage: { ...full, entryLoadingIdentity: 'different' },
+    };
+    expected = 'entry loader';
+  } else if (mode === 'capability') {
+    globalThis._FEDERATION_RUNTIME_CORE_FROM = {
+      ...current,
+      runtimeImage: { ...full, available: [], required: ['shared'] },
+    };
+    expected = 'missing capability remote';
+  } else if (override) {
+    expected = 'forbidden capability snapshot';
+  } else if (mode === 'forbidden' && !process.env.PROOF_LEGACY_FULL) {
+    expected = 'forbidden capability snapshot';
+  } else if (mode === 'old7aca-tagged' || mode === 'old7aca-legacy') {
+    if (!process.env.PROOF_OLD_KERNEL_PROVIDER_PATH)
+      globalThis._FEDERATION_RUNTIME_CORE = require(
+        process.env.PROOF_OLD_KERNEL_CORE_PATH,
+      );
+    if (mode === 'old7aca-tagged') expected = '[RuntimeImageMinimumContract]';
+  } else if (mode === 'old94aa-tagged') {
+    globalThis._FEDERATION_RUNTIME_CORE = require(
+      process.env.PROOF_OLD_CORE_PATH,
+    );
+    expected = '[RuntimeImageMinimumContract]';
+  } else if (mode.startsWith('root-')) {
+    globalThis._FEDERATION_RUNTIME_CORE = {
+      ...core,
+      [mode.slice(5)]: undefined,
+    };
+    expected =
+      mode === 'root-Global'
+        ? '[RuntimeImageMinimumContract]'
+        : '[ExternalRuntimeKernelContract]';
+  } else if (mode === 'transport-tagged') {
+    expected = '[RuntimeImageTransportBoundary]';
+  }
+  const producer =
+    supplied || override
+      ? require(path.join(dir, 'out/producer.cjs'))
+      : undefined;
+  const before = snap();
+  const entry = publication
+    ? 'provider-tagged.cjs'
+    : mode === 'both-absent' ||
+        mode === 'provider-only' ||
+        mode === 'old7aca-legacy'
+      ? 'consumer-untagged.cjs'
+      : mode === 'forbidden'
+        ? 'consumer-forbidden.cjs'
+        : mode === 'transport-tagged' || mode === 'transport-legacy'
+          ? 'consumer-commonjs.cjs'
+          : 'consumer-tagged.cjs';
+  if (expected) {
+    assert.throws(
+      () =>
+        lateHook
+          ? producer.publishLateHook()
+          : override
+            ? producer.publishWithPlugin({ ...full, forbidden: ['snapshot'] })
+            : supplied
+              ? producer[
+                  mode.includes('-options-')
+                    ? 'publishOptions'
+                    : 'publishConfig'
+                ](invalid[mode.split('-').at(-1)])
+              : require(path.join(dir, 'out', entry)),
+      (e) => e.message.includes(expected),
+    );
+    unchanged(before);
+    console.log(
+      JSON.stringify({
+        mode,
+        rejected: expected,
+        publicationAndStateUnchanged: true,
+      }),
+    );
+  } else {
+    const consumer = await require(path.join(dir, 'out', entry)).default;
+    assert.ok(consumer.instance);
+    assert.equal(consumer.instance.constructor, before.core.ModuleFederation);
+    assert.ok(consumer.instance instanceof before.core.ModuleFederation);
+    assert.equal(consumer.shared.literal, 'shared-provider-literal');
+    assert.equal(consumer.remote.literal, 'remote-file-literal');
+    assert.equal(consumer.shared, consumer.remote.shared);
+    consumer.instance.registerRemotes([
+      {
+        name: 'dataRemote',
+        entry:
+          'data:text/javascript,' +
+          encodeURIComponent(
+            "module.exports={init(){},get(){return Promise.resolve(()=>({default:'runtime-data-url-remote-literal'}));}};",
+          ),
+        type: 'commonjs',
+        entryGlobalName: 'dataRemote',
+      },
+    ]);
+    assert.equal(
+      (await consumer.instance.loadRemote('dataRemote/literal')).default,
+      'runtime-data-url-remote-literal',
+    );
+    if (mode === 'provider-only' || mode === 'consumer-only')
+      assert.ok(warnings.some((w) => w.includes('metadata is missing')));
+    if (mode === 'captured-defines') {
+      assert.deepEqual(before.from.runtimeImage, full);
+      assert.deepEqual(before.core.readRuntimeImage(consumer.instance), full);
+    }
+    if (mode === 'transport-legacy') {
+      const direct = require(path.join(dir, 'out/direct-commonjs.cjs')).default;
+      assert.equal(direct.core, before.core);
+      assert.equal(direct.namespace.customExtra, 'preserved-extra-export');
+    }
+    if (mode === 'compatible') {
+      assert.ok(
+        !warnings.some((w) => w.includes('metadata is missing')),
+        warnings.join('\n'),
+      );
+      assert.deepEqual(before.from.runtimeImage, full);
+      assert.ok(Object.isFrozen(before.from.runtimeImage));
+      for (const key of ['required', 'available', 'forbidden'])
+        assert.ok(Object.isFrozen(before.from.runtimeImage[key]));
+      assert.deepEqual(before.core.readRuntimeImage(provider.instance), full);
+      assert.deepEqual(before.core.readRuntimeImage(consumer.instance), full);
+    }
+    if (mode === 'both-absent' || mode === 'old7aca-legacy')
+      assert.ok(!warnings.some((w) => w.includes('metadata is missing')));
+    assert.equal(globalThis._FEDERATION_RUNTIME_CORE, before.core);
+    assert.equal(globalThis._FEDERATION_RUNTIME_CORE_FROM, before.from);
+    console.log(
+      JSON.stringify({
+        mode,
+        admission: [
+          'both-absent',
+          'provider-only',
+          'consumer-only',
+          'old7aca-legacy',
+          'transport-legacy',
+        ].includes(mode)
+          ? 'unchecked'
+          : 'compatible',
+        constructorIdentity: true,
+        sharedIdentity: true,
+        fileRemote: true,
+        sdkRemote: true,
+        missingMetadataWarning: warnings.some((w) =>
+          w.includes('metadata is missing'),
+        ),
+      }),
+    );
+  }
+  if (mode === 'compatible')
+    fs.writeFileSync(
+      path.join(dir, 'compatible-warning-stacks.log'),
+      traces.join('\n'),
+    );
+  console.warn = original;
+} else {
+  const imported = process.env.PROOF_RSPACK_CORE_PATH
+    ? require(process.env.PROOF_RSPACK_CORE_PATH)
+    : await import('@rspack/core');
+  const rspack = imported.rspack ?? imported.default.rspack;
+  const { ModuleFederationPlugin } = require('../../dist/index.js');
+  fs.mkdirSync(dir, { recursive: true });
+  fs.mkdirSync(path.join(dir, 'node_modules/_FEDERATION_RUNTIME_CORE'), {
+    recursive: true,
+  });
+  fs.writeFileSync(
+    path.join(dir, 'node_modules/_FEDERATION_RUNTIME_CORE/index.js'),
+    'module.exports=globalThis._FEDERATION_RUNTIME_CORE;',
+  );
+  fs.writeFileSync(path.join(dir, 'package.json'), '{}');
+  fs.writeFileSync(
+    path.join(dir, 'shared.js'),
+    "module.exports={literal:'shared-provider-literal',marker:{}};",
+  );
+  fs.writeFileSync(
+    path.join(dir, 'provider.js'),
+    "import shared from 'proof-shared';export default {shared,instance:__webpack_require__.federation.instance};",
+  );
+  fs.writeFileSync(
+    path.join(dir, 'remote.js'),
+    "import shared from 'proof-shared';export default {shared,literal:'remote-file-literal'};",
+  );
+  fs.writeFileSync(
+    path.join(dir, 'consumer.js'),
+    "import shared from 'proof-shared';export default import('remote/literal').then(({default:remote})=>({shared,remote,instance:__webpack_require__.federation.instance}));",
+  );
+  fs.writeFileSync(
+    path.join(dir, 'producer.js'),
+    `import {createInstance} from ${JSON.stringify(require.resolve('@module-federation/runtime', { paths: [require.resolve('@module-federation/runtime-tools')] }))};import inject from ${JSON.stringify(require.resolve('@module-federation/inject-external-runtime-core-plugin'))};export function publishConfig(runtimeImage){return createInstance({name:'supplied',remotes:[],plugins:[inject({runtimeImage})]});}export function publishOptions(runtimeImage){return createInstance({name:'supplied',remotes:[],runtimeImage,plugins:[inject()]});}export function publishLateHook(){return createInstance({name:'late-hook',remotes:[],runtimeImage:${JSON.stringify(full)},plugins:[inject({runtimeImage:${JSON.stringify(full)}}),{name:'later-invalid-image',beforeInit(args){return {...args,userOptions:{...args.userOptions,runtimeImage:null}};}}]});}export function publishWithPlugin(runtimeImage){return createInstance({name:'direct-request',remotes:[],runtimeImage,plugins:[inject({runtimeImage:${JSON.stringify(full)},publish:false})]});}`,
+  );
+  fs.writeFileSync(
+    path.join(dir, 'direct-commonjs.js'),
+    "import core from '@module-federation/runtime-core';import * as namespace from '@module-federation/runtime-core';export default {core,namespace};",
+  );
+  fs.writeFileSync(
+    path.join(dir, 'direct-root.js'),
+    "import {ModuleFederation} from '@module-federation/runtime-core';export default ModuleFederation;",
+  );
+  const base = {
+    name: 'unused',
+    dts: false,
+    manifest: false,
+    bridge: { enableBridgeRouter: false },
