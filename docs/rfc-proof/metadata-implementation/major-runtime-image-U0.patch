@@ -0,0 +1,259 @@
+import { describe, expect, it, rs } from '@rstest/core';
+import { ModuleFederation, CurrentGlobal } from '../src';
+import { SharedHandler } from '../src/shared';
+import { RemoteHandler } from '../src/remote';
+import {
+  parseRuntimeImage,
+  readRuntimeImage,
+  attachRuntimeImage,
+  assertRuntimeImageCompatible,
+} from '../src/runtimeImage';
+
+const image = () => ({
+  contract: 1,
+  compatibilityId: 'abi-v1',
+  target: 'node',
+  entryLoadingIdentity: 'sdk-node-v1',
+  required: ['shared'],
+  available: ['shared', 'remote'],
+  forbidden: [],
+});
+
+describe('runtime-image v1 admission', () => {
+  it('copies and freezes the exact validated snapshot', () => {
+    const input = image();
+    const parsed = parseRuntimeImage(input)!;
+    expect(parsed).not.toBe(input);
+    for (const key of ['required', 'available', 'forbidden'] as const) {
+      expect(parsed[key]).not.toBe(input[key]);
+      expect(Object.isFrozen(parsed[key])).toBe(true);
+    }
+    expect(Object.isFrozen(parsed)).toBe(true);
+    input.available.push('later');
+    input.compatibilityId = 'later';
+    expect(parsed.available).toEqual(['shared', 'remote']);
+    expect(parsed.compatibilityId).toBe('abi-v1');
+    let reads = 0;
+    const changing = {
+      ...image(),
+      get compatibilityId() {
+        return ++reads === 1 ? 'once' : undefined;
+      },
+    };
+    expect(parseRuntimeImage(changing)?.compatibilityId).toBe('once');
+    expect(reads).toBe(1);
+  });
+
+  it.each(
+    [
+      null,
+      false,
+      [],
+      {},
+      { ...image(), contract: 2 },
+      ...(['required', 'available', 'forbidden'] as const).flatMap((key) => [
+        { ...image(), [key]: [null] },
+        { ...image(), [key]: new Array(1) },
+      ]),
+    ].map((input) => [input]),
+  )('rejects malformed supplied metadata even beside absence: %p', (input) => {
+    expect(() => assertRuntimeImageCompatible(undefined, input)).toThrow(
+      '[RuntimeImageContract]',
+    );
+  });
+
+  it('retains the supported union comparisons and explicit missing policy', () => {
+    expect(() =>
+      assertRuntimeImageCompatible(
+        { ...image(), available: [], required: ['shared', 'remote'] },
+        image(),
+      ),
+    ).not.toThrow();
+    expect(() =>
+      assertRuntimeImageCompatible(image(), {
+        ...image(),
+        required: ['snapshot'],
+      }),
+    ).toThrow('missing capability snapshot');
+    expect(() =>
+      assertRuntimeImageCompatible(image(), {
+        ...image(),
+        forbidden: ['remote'],
+      }),
+    ).toThrow('forbidden capability remote');
+    expect(() =>
+      assertRuntimeImageCompatible(image(), {
+        ...image(),
+        compatibilityId: 'other',
+      }),
+    ).toThrow('runtime state');
+    expect(() =>
+      assertRuntimeImageCompatible(image(), { ...image(), target: 'web' }),
+    ).toThrow('runtime image');
+    expect(() =>
+      assertRuntimeImageCompatible(image(), {
+        ...image(),
+        entryLoadingIdentity: 'other',
+      }),
+    ).toThrow('entry loader');
+    expect(() =>
+      assertRuntimeImageCompatible(undefined, undefined),
+    ).not.toThrow();
+    expect(() =>
+      assertRuntimeImageCompatible(image(), undefined),
+    ).not.toThrow();
+  });
+
+  it('normalizes existing plugin associations before first admission without self-comparison', () => {
+    const overlap = parseRuntimeImage({ ...image(), forbidden: ['shared'] })!;
+    const plugin = { name: 'tagged' };
+    attachRuntimeImage(plugin, {
+      ...overlap,
+      available: ['remote', 'shared', 'shared'],
+    });
+    const instance = new ModuleFederation({
+      name: 'tagged',
+      remotes: [],
+      runtimeImage: overlap,
+      plugins: [plugin],
+    });
+    expect(readRuntimeImage(instance)).toEqual(overlap);
+  });
+
+  it('attaches an immutable independent association', () => {
+    const input = image();
+    const instance = {};
+    attachRuntimeImage(instance, input);
+    input.required.push('later');
+    expect(readRuntimeImage(instance)?.required).toEqual(['shared']);
+  });
+
+  it('rejects before handlers or plugin registration can change state', () => {
+    const registry = CurrentGlobal.__FEDERATION__;
+    const shares = { ...registry.__SHARE__ };
+    const malformed = { name: 'malformed', remotes: [] };
+    Reflect.set(malformed, 'runtimeImage', null);
+    expect(() => new ModuleFederation(malformed)).toThrow(
+      '[RuntimeImageContract]',
+    );
+    expect(registry.__SHARE__).toEqual(shares);
+    const instance = new ModuleFederation({
+      name: 'valid',
+      remotes: [],
+      runtimeImage: parseRuntimeImage(image()),
+    });
+    const before = instance.options;
+    const register = rs.spyOn(instance, 'registerPlugins');
+    expect(() =>
+      instance.initOptions({
+        name: 'valid',
+        remotes: [],
+        runtimeImage: parseRuntimeImage({ ...image(), target: 'web' }),
+      }),
+    ).toThrow('runtime image');
+    expect(instance.options).toBe(before);
+    expect(register).not.toHaveBeenCalled();
+  });
+
+  it('retains known first-admission constraints across beforeInit hook output', () => {
+    const shared = rs.spyOn(SharedHandler.prototype, 'registerShared');
+    const remote = rs.spyOn(RemoteHandler.prototype, 'formatAndRegisterRemote');
+    expect(
+      () =>
+        new ModuleFederation({
+          name: 'changed-hook',
+          remotes: [],
+          runtimeImage: parseRuntimeImage(image()),
+          plugins: [
+            {
+              name: 'changed-image',
+              beforeInit(args) {
+                return {
+                  ...args,
+                  userOptions: {
+                    ...args.userOptions,
+                    runtimeImage: parseRuntimeImage({
+                      ...image(),
+                      compatibilityId: 'different',
+                    }),
+                  },
+                };
+              },
+            },
+          ],
+        }),
+    ).toThrow('runtime state');
+    expect(shared).not.toHaveBeenCalled();
+    expect(remote).not.toHaveBeenCalled();
+    shared.mockRestore();
+    remote.mockRestore();
+    const added = new ModuleFederation({
+      name: 'added-hook',
+      remotes: [],
+      plugins: [
+        {
+          name: 'added-image',
+          beforeInit(args) {
+            return {
+              ...args,
+              userOptions: {
+                ...args.userOptions,
+                runtimeImage: parseRuntimeImage(image()),
+              },
+            };
+          },
+        },
+      ],
+    });
+    expect(readRuntimeImage(added)).toEqual(image());
+  });
+
+  it('retains the admitted immutable image when a hook removes both options tags', () => {
+    const admitted = parseRuntimeImage(image())!;
+    const instance = new ModuleFederation({
+      name: 'removed-hook',
+      remotes: [],
+      runtimeImage: admitted,
+      plugins: [
+        {
+          name: 'remove-image',
+          beforeInit(args) {
+            return {
+              ...args,
+              options: { ...args.options, runtimeImage: undefined },
+              userOptions: { ...args.userOptions, runtimeImage: undefined },
+            };
+          },
+        },
+      ],
