+import { describe, expect, it } from '@rstest/core';
+import { normalizeWebpackPath } from '@module-federation/sdk/normalize-webpack-path';
+import ModuleFederationPlugin from '../../../src/lib/container/ModuleFederationPlugin';
+
+const webpack: typeof import('webpack') = require(
+  normalizeWebpackPath('webpack'),
+);
+
+describe('runtime-image compiler boundary', () => {
+  it('rejects the Rspack-only profile on an actual Webpack compiler', () => {
+    expect(() =>
+      webpack({
+        mode: 'none',
+        entry: {},
+        plugins: [
+          new ModuleFederationPlugin({
+            name: 'profile',
+            dts: false,
+            manifest: false,
+            experiments: {
+              externalRuntime: true,
+              runtimeImage: {
+                compatibilityId: 'abi',
+                entryLoadingIdentity: 'loader',
+              },
+              optimization: { target: 'node' },
+            },
+          }),
+        ],
+      }),
+    ).toThrow(
+      '[RuntimeImageDerivation] Enhanced compiler runtime-image profiles are unavailable.',
+    );
+  });
+});
