+import { error, warn } from './utils/logger';
+
+export const RUNTIME_IMAGE = Symbol.for('module-federation.runtime-image.v1');
+
+export interface RuntimeImageDescriptorV1 {
+  readonly contract: 1;
+  readonly compatibilityId: string;
+  readonly required: readonly string[];
+  readonly forbidden: readonly string[];
+  readonly available: readonly string[];
+  readonly target: string;
+  readonly entryLoadingIdentity: string;
+}
+
+export function parseRuntimeImage(
+  value: unknown,
+): RuntimeImageDescriptorV1 | undefined {
+  // This boundary is self-contained so compilers can emit the same parser before
+  // dereferencing an external core that might not yet support this contract.
+  const fail = (message: string): never => {
+    throw new Error('[RuntimeImageContract] ' + message);
+  };
+  const nonempty = (entry: unknown): entry is string =>
+    typeof entry === 'string' && entry.trim().length > 0;
+  const list = (entry: unknown): entry is readonly string[] =>
+    Array.isArray(entry) && Array.from(entry).every(nonempty);
+  if (value === undefined) return undefined;
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    return fail('Invalid runtime-image descriptor.');
+  }
+  const contract: unknown = Reflect.get(value, 'contract');
+  if (contract !== 1) {
+    return fail('Unsupported runtime-image contract; expected 1.');
+  }
+  const compatibilityId: unknown = Reflect.get(value, 'compatibilityId');
+  const target: unknown = Reflect.get(value, 'target');
+  const entryLoadingIdentity: unknown = Reflect.get(
+    value,
+    'entryLoadingIdentity',
+  );
+  const snapshotList = (key: string): unknown => {
+    const entry: unknown = Reflect.get(value, key);
+    return Array.isArray(entry) ? Array.from(entry) : entry;
+  };
+  const required = snapshotList('required');
+  const forbidden = snapshotList('forbidden');
+  const available = snapshotList('available');
+  if (
+    !nonempty(compatibilityId) ||
+    !nonempty(target) ||
+    !nonempty(entryLoadingIdentity) ||
+    !list(required) ||
+    !list(forbidden) ||
+    !list(available)
+  ) {
+    return fail('Invalid runtime-image descriptor fields.');
+  }
+  return Object.freeze({
+    contract: 1,
+    compatibilityId,
+    target,
+    entryLoadingIdentity,
+    required: Object.freeze(required),
+    forbidden: Object.freeze(forbidden),
+    available: Object.freeze(available),
+  });
+}
+
+export function readRuntimeImage(
+  instance: object,
+): RuntimeImageDescriptorV1 | undefined {
+  const image: unknown = Reflect.get(instance, RUNTIME_IMAGE);
+  return parseRuntimeImage(image);
+}
+
+export function attachRuntimeImage(instance: object, image: unknown): void {
+  const descriptor = parseRuntimeImage(image);
+  Object.defineProperty(instance, RUNTIME_IMAGE, {
+    value: descriptor,
+    enumerable: false,
+    configurable: true,
+  });
+}
+
+export function assertRuntimeImageCompatible(
+  currentImage: unknown,
+  nextImage: unknown,
+): void {
+  const current = parseRuntimeImage(currentImage);
+  const next = parseRuntimeImage(nextImage);
+  if (!current || !next) {
+    if (current || next) {
+      warn(
+        'Runtime image metadata is missing. Reuse stays allowed until a mismatch is known.',
+      );
+    }
+    return;
+  }
+  if (current.compatibilityId !== next.compatibilityId) {
+    error(
+      `Refusing to reuse runtime state from ${current.compatibilityId} with ${next.compatibilityId}.`,
+    );
+  }
+  if (current.target !== next.target) {
+    error(
+      `Refusing to reuse a ${current.target} runtime image for ${next.target}.`,
+    );
+  }
+  if (current.entryLoadingIdentity !== next.entryLoadingIdentity) {
+    error(
+      `Refusing to reuse entry loader ${current.entryLoadingIdentity} with ${next.entryLoadingIdentity}.`,
+    );
+  }
+  const provided = new Set([...current.available, ...current.required]);
+  for (const capability of new Set([...next.required, ...next.available])) {
+    if (!provided.has(capability)) {
+      error(`Runtime image is missing capability ${capability}.`);
+    }
+  }
+  for (const capability of next.forbidden) {
+    if (provided.has(capability)) {
+      error(`Runtime image exposes forbidden capability ${capability}.`);
+    }
+  }
+}
