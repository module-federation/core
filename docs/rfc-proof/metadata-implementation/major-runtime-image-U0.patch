+import { describe, expect, it } from '@rstest/core';
+import { createInstance } from '../src';
+import {
+  CurrentGlobal,
+  attachRuntimeImage,
+  parseRuntimeImage,
+  readRuntimeImage,
+} from '@module-federation/runtime-core';
+
+const image = () =>
+  parseRuntimeImage({
+    contract: 1,
+    compatibilityId: 'abi',
+    target: 'node',
+    entryLoadingIdentity: 'loader',
+    required: ['shared', 'remote'],
+    available: ['shared', 'remote'],
+    forbidden: [],
+  })!;
+
+describe('runtime image options and plugin association', () => {
+  it('normalizes compiler plugin metadata before construction and retains its final image', () => {
+    const plugin = { name: 'compiled-image' };
+    attachRuntimeImage(plugin, image());
+    const instance = createInstance({
+      name: 'tagged',
+      remotes: [],
+      plugins: [plugin],
+    });
+    expect(readRuntimeImage(instance)).toEqual(image());
+    expect(instance.options.runtimeImage).toEqual(image());
+    expect(Object.isFrozen(instance.options.runtimeImage)).toBe(true);
+  });
+
+  it('checks config-tagged families before construction or global registration', () => {
+    createInstance({ name: 'existing', remotes: [], runtimeImage: image() });
+    const registry = CurrentGlobal.__FEDERATION__;
+    const instances = [...registry.__INSTANCES__];
+    const shares = { ...registry.__SHARE__ };
+    const plugin = { name: 'different-family' };
+    attachRuntimeImage(plugin, { ...image(), compatibilityId: 'other' });
+    expect(() =>
+      createInstance({ name: 'rejected', remotes: [], plugins: [plugin] }),
+    ).toThrow('runtime family other');
+    expect(registry.__INSTANCES__).toEqual(instances);
+    expect(registry.__SHARE__).toEqual(shares);
+  });
+
+  it('rejects incompatible direct requests against a tagged implementation before construction', () => {
+    const registry = CurrentGlobal.__FEDERATION__;
+    const shares = { ...registry.__SHARE__ };
+    const plugin = { name: 'shared-only' };
+    attachRuntimeImage(plugin, {
+      ...image(),
+      required: ['shared'],
+      available: ['shared'],
+    });
+    expect(() =>
+      createInstance({
+        name: 'rejected',
+        remotes: [],
+        runtimeImage: image(),
+        plugins: [plugin],
+      }),
+    ).toThrow('missing capability remote');
+    expect(registry.__SHARE__).toEqual(shares);
+  });
+
+  it('treats equivalent set claims as one structural first admission', () => {
+    const overlap = { ...image(), forbidden: ['shared'] };
+    const plugin = { name: 'equivalent-claim' };
+    attachRuntimeImage(plugin, {
+      ...overlap,
+      required: ['remote', 'shared', 'shared'],
+      available: ['remote', 'shared'],
+    });
+    const instance = createInstance({
+      name: 'equal',
+      remotes: [],
+      runtimeImage: parseRuntimeImage(overlap),
+      plugins: [plugin],
+    });
+    expect(readRuntimeImage(instance)).toEqual(overlap);
+  });
+});
