@@ -0,0 +1,65 @@
+import { initContainerEntry } from '../src/initContainerEntry';
+import { createInstance } from '@module-federation/runtime';
+import { parseRuntimeImage } from '@module-federation/runtime/core';
+import type { WebpackRequire } from '../src/types';
+
+it('retains the admitted image for same-instance scope initialization and rejects explicit mismatches', () => {
+  const runtimeImage = parseRuntimeImage({
+    contract: 1,
+    compatibilityId: 'abi',
+    target: 'node',
+    entryLoadingIdentity: 'loader',
+    required: [],
+    available: [],
+    forbidden: [],
+  });
+  const instance = createInstance({
+    name: 'image-container',
+    remotes: [],
+    runtimeImage,
+  });
+  const initOptions = { name: 'image-container', remotes: [] };
+  const webpackRequire = Object.assign(
+    (_moduleId: string | number) => undefined,
+    {
+      p: '',
+      o: (object: Record<string, unknown>, key: string | number) =>
+        Object.hasOwn(object, key),
+      R: [],
+      m: {},
+      c: {},
+      S: {},
+      I: jest.fn(),
+      federation: { instance, initOptions, bundlerRuntimeOptions: {} },
+    },
+  ) satisfies WebpackRequire;
+  const warn = jest.spyOn(console, 'warn').mockImplementation(() => {});
+  try {
+    initContainerEntry({
+      webpackRequire,
+      shareScope: {},
+      initScope: [],
+      shareScopeKey: 'default',
+    });
+    expect(instance.options.runtimeImage).toEqual(runtimeImage);
+    expect(warn).not.toHaveBeenCalled();
+    const before = instance.options;
+    const foreign = {
+      version: 'foreign',
+      shareScopeMap: {},
+      runtimeImage: parseRuntimeImage({ ...runtimeImage, target: 'web' }),
+    };
+    expect(() =>
+      initContainerEntry({
+        webpackRequire,
+        shareScope: {},
+        initScope: [],
+        shareScopeKey: 'default',
+        remoteEntryInitOptions: foreign,
+      }),
+    ).toThrow('runtime image');
+    expect(instance.options).toBe(before);
+  } finally {
+    warn.mockRestore();
+  }
+});
